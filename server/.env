PORT=5000
NODE_ENV=development

# Local MySQL configuration for development
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=tsms_db

# Optional: use a live online database instead later
# DATABASE_URL=mysql://user:password@host:3306/database_name

# JWT
JWT_SECRET=tsms_jwt_secret_key_2026_change_in_production
