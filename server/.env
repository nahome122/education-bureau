PORT=5000
NODE_ENV=production

# Online MySQL Database
DATABASE_URL=mysql://your_db_user:your_db_password@your_db_host:3306/your_db_name

# If you prefer individual variables instead of DATABASE_URL:
# DB_HOST=your_db_host
# DB_PORT=3306
# DB_USER=your_db_user
# DB_PASSWORD=your_db_password
# DB_NAME=your_db_name

# JWT
JWT_SECRET=tsms_jwt_secret_key_2026_change_in_production
JWT_EXPIRES_IN=8h
JWT_REFRESH_SECRET=tsms_refresh_secret_key_2026
JWT_REFRESH_EXPIRES_IN=7d

# CORS
CLIENT_URL=http://localhost:5173
# For production, replace with your deployed frontend URL
