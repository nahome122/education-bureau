{
  "name": "tsms-root",
  "version": "1.0.0",
  "description": "Teacher & Staff Management System",
  "scripts": {
    "start": "node server/src/index.js",
    "start:both": "concurrently \"npm run start --prefix server\" \"npm run dev --prefix client\"",
    "server": "npm run dev --prefix server",
    "client": "npm run dev --prefix client",
    "setup-db": "node server/src/scripts/setupDb.js"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "mysql2": "^3.22.5"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
