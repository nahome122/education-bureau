<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> | TSMS</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="/style.css">
</head>
<body class="app-body">
    <aside class="sidebar" id="sidebar">
        <div class="sidebar-header">
            <div class="sidebar-logo"><i class="fas fa-graduation-cap"></i><div><h2>TSMS</h2><span>Education Bureau</span></div></div>
            <button class="sidebar-close" id="sidebarCloseBtn" onclick="toggleSidebar()"><i class="fas fa-times"></i></button>
        </div>
        <nav class="sidebar-nav">
            <a href="/dashboard" class="nav-link active" id="navDashboard"><i class="fas fa-chart-pie"></i><span>Dashboard</span></a>
            <a href="/teachers" class="nav-link" id="navTeachers"><i class="fas fa-chalkboard-teacher"></i><span>Teachers</span></a>
            <a href="/schools" class="nav-link" id="navSchools"><i class="fas fa-school"></i><span>Schools</span></a>
            <a href="/staff" class="nav-link" id="navStaff"><i class="fas fa-users-cog"></i><span>Staff</span></a>
            <% if (user && user.role === 'admin') { %>
            <a href="/users" class="nav-link" id="navUsers"><i class="fas fa-user-shield"></i><span>Users</span></a>
            <% } %>
        </nav>
        <div class="sidebar-footer">
            <div class="user-info">
                <div class="user-avatar" style="background:<%= user ? user.avatar_color : '#10b981' %>"><%= user ? user.full_name.charAt(0).toUpperCase() : 'A' %></div>
                <div class="user-details"><span class="user-name"><%= user ? user.full_name : 'Admin' %></span><span class="user-role"><%= user ? user.role : 'admin' %></span></div>
            </div>
            <a href="/logout" class="btn-logout" id="logoutBtn"><i class="fas fa-sign-out-alt"></i></a>
        </div>
    </aside>

    <main class="main-content">
        <header class="top-bar">
            <div class="top-bar-left">
                <button class="menu-toggle" id="menuToggleBtn" onclick="toggleSidebar()"><i class="fas fa-bars"></i></button>
                <div><h1>Dashboard</h1><p class="breadcrumb">Welcome back, <strong><%= user ? user.full_name : 'Admin' %></strong></p></div>
            </div>
            <div class="top-bar-right"><div class="current-date"><i class="fas fa-calendar-alt"></i><span id="currentDate"></span></div></div>
        </header>

        <% if (success_msg && success_msg.length > 0) { %>
        <div class="alert alert-success page-alert"><i class="fas fa-check-circle"></i><span><%= success_msg[0] %></span><button onclick="this.parentElement.remove()" class="alert-close">&times;</button></div>
        <% } %>
        <% if (error_msg && error_msg.length > 0) { %>
        <div class="alert alert-error page-alert"><i class="fas fa-exclamation-circle"></i><span><%= error_msg[0] %></span><button onclick="this.parentElement.remove()" class="alert-close">&times;</button></div>
        <% } %>

        <div class="stats-grid">
            <div class="stat-card stat-teachers"><div class="stat-icon"><i class="fas fa-chalkboard-teacher"></i></div><div class="stat-info"><h3><%= stats.totalTeachers %></h3><p>Total Teachers</p></div><div class="stat-footer"><span class="stat-badge active"><%= stats.activeTeachers %> Active</span><span class="stat-badge on-leave"><%= stats.onLeaveTeachers %> On Leave</span></div></div>
            <div class="stat-card stat-staff"><div class="stat-icon"><i class="fas fa-users-cog"></i></div><div class="stat-info"><h3><%= stats.totalStaff %></h3><p>Total Staff</p></div><div class="stat-footer"><span class="stat-badge active"><%= stats.activeStaff %> Active</span><span class="stat-badge on-leave"><%= stats.onLeaveStaff %> On Leave</span></div></div>
            <div class="stat-card stat-users"><div class="stat-icon"><i class="fas fa-user-shield"></i></div><div class="stat-info"><h3><%= stats.totalUsers %></h3><p>System Users</p></div><div class="stat-footer"><span class="stat-badge active">Administrators</span></div></div>
            <div class="stat-card stat-total"><div class="stat-icon"><i class="fas fa-building"></i></div><div class="stat-info"><h3><%= stats.totalTeachers + stats.totalStaff %></h3><p>Total Personnel</p></div><div class="stat-footer"><span class="stat-badge active">All Members</span></div></div>
        </div>

        <div class="section-header"><h2><i class="fas fa-bolt"></i> Quick Actions</h2></div>
        <div class="quick-actions">
            <a href="/teachers" class="action-card" id="actionTeachers"><div class="action-icon" style="background:linear-gradient(135deg,#10b981,#059669)"><i class="fas fa-user-plus"></i></div><span>Manage Teachers</span></a>
            <a href="/staff" class="action-card" id="actionStaff"><div class="action-icon" style="background:linear-gradient(135deg,#8b5cf6,#7c3aed)"><i class="fas fa-user-tie"></i></div><span>Manage Staff</span></a>
            <% if (user && user.role === 'admin') { %>
            <a href="/users" class="action-card" id="actionUsers"><div class="action-icon" style="background:linear-gradient(135deg,#f59e0b,#d97706)"><i class="fas fa-users"></i></div><span>Manage Users</span></a>
            <% } %>
        </div>

        <div class="tables-grid">
            <div class="table-card">
                <div class="table-header"><h2><i class="fas fa-chalkboard-teacher"></i> Recent Teachers</h2><a href="/teachers" class="btn btn-sm btn-outline">View All</a></div>
                <div class="table-responsive"><table><thead><tr><th>Name</th><th>Subject</th><th>School</th><th>Status</th></tr></thead><tbody>
                <% if (recentTeachers.length > 0) { recentTeachers.forEach(t => { %>
                <tr><td><div class="cell-with-avatar"><div class="mini-avatar" style="background:<%= t.gender==='Male'?'#3b82f6':'#ec4899' %>"><%= t.full_name.charAt(0) %></div><%= t.full_name %></div></td><td><%= t.subject_specialization %></td><td><%= t.school_name %></td><td><span class="status-badge status-<%= t.status.toLowerCase().replace(' ','-') %>"><%= t.status %></span></td></tr>
                <% }) } else { %><tr><td colspan="4" class="empty-state">No teachers found</td></tr><% } %>
                </tbody></table></div>
            </div>
            <div class="table-card">
                <div class="table-header"><h2><i class="fas fa-users-cog"></i> Recent Staff</h2><a href="/staff" class="btn btn-sm btn-outline">View All</a></div>
                <div class="table-responsive"><table><thead><tr><th>Name</th><th>Position</th><th>Department</th><th>Status</th></tr></thead><tbody>
                <% if (recentStaff.length > 0) { recentStaff.forEach(s => { %>
                <tr><td><div class="cell-with-avatar"><div class="mini-avatar" style="background:<%= s.gender==='Male'?'#3b82f6':'#ec4899' %>"><%= s.full_name.charAt(0) %></div><%= s.full_name %></div></td><td><%= s.position %></td><td><%= s.department %></td><td><span class="status-badge status-<%= s.status.toLowerCase().replace(' ','-') %>"><%= s.status %></span></td></tr>
                <% }) } else { %><tr><td colspan="4" class="empty-state">No staff found</td></tr><% } %>
                </tbody></table></div>
            </div>
        </div>
    </main>
    <script>
    document.getElementById('currentDate').textContent=new Date().toLocaleDateString('en-US',{weekday:'long',year:'numeric',month:'long',day:'numeric'});
    function toggleSidebar(){document.getElementById('sidebar').classList.toggle('sidebar-open');document.querySelector('.main-content').classList.toggle('main-shifted');}
    setTimeout(()=>{document.querySelectorAll('.page-alert').forEach(el=>{el.style.animation='slideUp 0.3s ease forwards';setTimeout(()=>el.remove(),300)})},5000);
    </script>
</body>
</html>
