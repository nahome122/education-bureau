<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> | TSMS</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="/style.css">
</head>
<body class="app-body">
    <aside class="sidebar" id="sidebar">
        <div class="sidebar-header">
            <div class="sidebar-logo"><i class="fas fa-graduation-cap"></i><div><h2>TSMS</h2><span>Education Bureau</span></div></div>
            <button class="sidebar-close" onclick="toggleSidebar()"><i class="fas fa-times"></i></button>
        </div>
        <nav class="sidebar-nav">
            <a href="/dashboard" class="nav-link"><i class="fas fa-chart-pie"></i><span>Dashboard</span></a>
            <a href="/teachers" class="nav-link active"><i class="fas fa-chalkboard-teacher"></i><span>Teachers</span></a>
            <a href="/schools" class="nav-link"><i class="fas fa-school"></i><span>Schools</span></a>
            <a href="/staff" class="nav-link"><i class="fas fa-users-cog"></i><span>Staff</span></a>
            <a href="/attendance" class="nav-link"><i class="fas fa-calendar-check"></i><span>Attendance</span></a>
            <a href="/leaves" class="nav-link"><i class="fas fa-calendar-times"></i><span>Leaves</span></a>
            <% if (user && user.role === 'admin') { %><a href="/users" class="nav-link"><i class="fas fa-user-shield"></i><span>Users</span></a><% } %>
        </nav>
        <div class="sidebar-footer">
            <div class="user-info"><div class="user-avatar" style="background:<%= user ? user.avatar_color : '#10b981' %>"><%= user ? user.full_name.charAt(0).toUpperCase() : 'A' %></div><div class="user-details"><span class="user-name"><%= user ? user.full_name : 'Admin' %></span><span class="user-role"><%= user ? user.role : 'admin' %></span></div></div>
            <a href="/logout" class="btn-logout"><i class="fas fa-sign-out-alt"></i></a>
        </div>
    </aside>

    <main class="main-content">
        <header class="top-bar">
            <div class="top-bar-left"><button class="menu-toggle" onclick="toggleSidebar()"><i class="fas fa-bars"></i></button><div><h1>Teachers Management</h1><p class="breadcrumb"><a href="/dashboard">Dashboard</a> / Teachers</p></div></div>
            <div class="top-bar-right" style="display:flex;gap:8px">
                <a href="/teachers/export?search=<%= search %>&status=<%= status %>" class="btn btn-outline" id="exportTeachersBtn"><i class="fas fa-file-csv"></i> Export CSV</a>
                <% if (user && canCreate('teachers')) { %><button class="btn btn-primary" onclick="openModal('addModal')" id="addTeacherBtn"><i class="fas fa-plus"></i> Add Teacher</button><% } %>
            </div>
        </header>

        <% if (success_msg && success_msg.length > 0) { %><div class="alert alert-success page-alert"><i class="fas fa-check-circle"></i><span><%= success_msg[0] %></span><button onclick="this.parentElement.remove()" class="alert-close">&times;</button></div><% } %>
        <% if (error_msg && error_msg.length > 0) { %><div class="alert alert-error page-alert"><i class="fas fa-exclamation-circle"></i><span><%= error_msg[0] %></span><button onclick="this.parentElement.remove()" class="alert-close">&times;</button></div><% } %>

        <!-- Search & Filter -->
        <div class="filter-bar">
            <form method="GET" action="/teachers" class="filter-form" id="teacherFilterForm">
                <div class="search-box"><i class="fas fa-search"></i><input type="text" name="search" placeholder="Search teachers..." value="<%= search %>" id="teacherSearch"></div>
                <select name="status" onchange="this.form.submit()" id="teacherStatusFilter">
                    <option value="">All Status</option>
                    <option value="Active" <%= status==='Active'?'selected':'' %>>Active</option>
                    <option value="On Leave" <%= status==='On Leave'?'selected':'' %>>On Leave</option>
                    <option value="Transferred" <%= status==='Transferred'?'selected':'' %>>Transferred</option>
                    <option value="Retired" <%= status==='Retired'?'selected':'' %>>Retired</option>
                </select>
                <button type="submit" class="btn btn-outline"><i class="fas fa-filter"></i> Filter</button>
            </form>
            <div class="filter-info"><span class="badge"><%= total %> records found</span></div>
        </div>

        <!-- Table -->
        <div class="table-card">
            <div class="table-responsive">
                <table>
                    <thead><tr><th>#</th><th>Full Name</th><th>Gender</th><th>Qualification</th><th>Subject</th><th>School</th><th>Phone</th><th>Status</th><th>Actions</th></tr></thead>
                    <tbody>
                    <% if (teachers.length > 0) {
                        let currentSchool = null;
                        let schoolIndex = -1;
                        let rowCount = 0;
                        teachers.forEach((t) => {
                            if (currentSchool !== t.school_name) {
                                currentSchool = t.school_name;
                                schoolIndex += 1;
                    %>
                    <tr class="school-group-header" onclick="toggleSchoolGroup(<%= schoolIndex %>)" style="cursor:pointer">
                        <td colspan="9"><strong><i class="fas fa-school"></i> <%= currentSchool %></strong> <span class="collapse-indicator" id="group-indicator-<%= schoolIndex %>">▾</span></td>
                    </tr>
                    <%      }
                            rowCount += 1;
                    %>
                    <tr class="school-group-row group-<%= schoolIndex %>">
                        <td><%= rowCount %></td>
                        <td><div class="cell-with-avatar"><div class="mini-avatar" style="background:<%= t.gender==='Male'?'#3b82f6':'#ec4899' %>"><%= t.full_name.charAt(0) %></div><a href="/teachers/<%= t.id %>" class="name-link"><%= t.full_name %></a></div></td>
                        <td><%= t.gender %></td>
                        <td><%= t.qualification %></td>
                        <td><%= t.subject_specialization %></td>
                        <td><%= t.school_name %></td>
                        <td><%= t.phone || '-' %></td>
                        <td><span class="status-badge status-<%= t.status.toLowerCase().replace(' ','-') %>"><%= t.status %></span></td>
                        <td class="actions-cell">
                            <% if (user && canUpdate('teachers')) { %><button class="btn-icon btn-edit" onclick="openEditModal(<%- JSON.stringify(t) %>)" title="Edit"><i class="fas fa-edit"></i></button><% } %>
                            <% if (user && canDelete('teachers')) { %><form action="/teachers/<%= t.id %>/delete" method="POST" style="display:inline" onsubmit="return confirm('Delete this teacher?')"><button type="submit" class="btn-icon btn-delete" title="Delete"><i class="fas fa-trash"></i></button></form><% } %>
                        </td>
                    </tr>
                    <%  })
                    } else { %>
                    <tr><td colspan="9" class="empty-state"><i class="fas fa-inbox"></i><br>No teachers found</td></tr>
                    <% } %>
                    </tbody>
                </table>
            </div>
        </div>
        <!-- Pagination -->
        <% if (totalPages > 1) { %>
        <div class="pagination">
            <% if (page > 1) { %><a href="/teachers?page=<%= page-1 %>&search=<%= search %>&status=<%= status %>" class="page-btn"><i class="fas fa-chevron-left"></i></a><% } %>
            <% for(let p=1; p<=totalPages; p++) { %><a href="/teachers?page=<%= p %>&search=<%= search %>&status=<%= status %>" class="page-btn <%= p===page?'page-active':'' %>"><%= p %></a><% } %>
            <% if (page < totalPages) { %><a href="/teachers?page=<%= page+1 %>&search=<%= search %>&status=<%= status %>" class="page-btn"><i class="fas fa-chevron-right"></i></a><% } %>
        </div>
        <% } %>
    </main>

    <!-- Add Modal -->
    <div class="modal-overlay" id="addModal">
        <div class="modal">
            <div class="modal-header"><h2><i class="fas fa-user-plus"></i> Add New Teacher</h2><button onclick="closeModal('addModal')" class="modal-close">&times;</button></div>
            <form action="/teachers" method="POST" class="modal-form">
                <div class="form-grid">
                    <div class="form-group"><label>Full Name *</label><input type="text" name="full_name" required></div>
                    <div class="form-group"><label>Gender *</label><select name="gender" required><option value="">Select</option><option value="Male">Male</option><option value="Female">Female</option></select></div>
                    <div class="form-group"><label>Qualification *</label><input type="text" name="qualification" required></div>
                    <div class="form-group"><label>Subject *</label><input type="text" name="subject_specialization" required></div>
                    <div class="form-group"><label>School *</label><select name="school_id" required>
                        <option value="">Select school</option>
                        <% schools.forEach((school) => { %>
                            <option value="<%= school.id %>"><%= school.name %></option>
                        <% }); %>
                    </select></div>
                    <div class="form-group"><label>Phone</label><input type="text" name="phone"></div>
                    <div class="form-group"><label>Email</label><input type="email" name="email"></div>
                    <div class="form-group"><label>Hire Date *</label><input type="date" name="hire_date" required></div>
                    <div class="form-group"><label>Salary</label><input type="number" name="salary" step="0.01"></div>
                    <div class="form-group"><label>Experience (Years)</label><input type="number" name="experience_years"></div>
                    <div class="form-group"><label>Status</label><select name="status"><option value="Active">Active</option><option value="On Leave">On Leave</option><option value="Transferred">Transferred</option><option value="Retired">Retired</option></select></div>
                </div>
                <div class="form-group full-width"><label>Notes</label><textarea name="notes" rows="2"></textarea></div>
                <div class="modal-actions"><button type="button" onclick="closeModal('addModal')" class="btn btn-outline">Cancel</button><button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> Save Teacher</button></div>
            </form>
        </div>
    </div>

    <!-- Edit Modal -->
    <div class="modal-overlay" id="editModal">
        <div class="modal">
            <div class="modal-header"><h2><i class="fas fa-edit"></i> Edit Teacher</h2><button onclick="closeModal('editModal')" class="modal-close">&times;</button></div>
            <form id="editForm" method="POST" class="modal-form">
                <div class="form-grid">
                    <div class="form-group"><label>Full Name *</label><input type="text" name="full_name" id="edit_full_name" required></div>
                    <div class="form-group"><label>Gender *</label><select name="gender" id="edit_gender" required><option value="Male">Male</option><option value="Female">Female</option></select></div>
                    <div class="form-group"><label>Qualification *</label><input type="text" name="qualification" id="edit_qualification" required></div>
                    <div class="form-group"><label>Subject *</label><input type="text" name="subject_specialization" id="edit_subject" required></div>
                    <div class="form-group"><label>School *</label><select name="school_id" id="edit_school" required>
                        <option value="">Select school</option>
                        <% schools.forEach((school) => { %>
                            <option value="<%= school.id %>"><%= school.name %></option>
                        <% }); %>
                    </select></div>
                    <div class="form-group"><label>Phone</label><input type="text" name="phone" id="edit_phone"></div>
                    <div class="form-group"><label>Email</label><input type="email" name="email" id="edit_email"></div>
                    <div class="form-group"><label>Hire Date *</label><input type="date" name="hire_date" id="edit_hire_date" required></div>
                    <div class="form-group"><label>Salary</label><input type="number" name="salary" id="edit_salary" step="0.01"></div>
                    <div class="form-group"><label>Experience</label><input type="number" name="experience_years" id="edit_experience"></div>
                    <div class="form-group"><label>Status</label><select name="status" id="edit_status"><option value="Active">Active</option><option value="On Leave">On Leave</option><option value="Transferred">Transferred</option><option value="Retired">Retired</option><option value="Terminated">Terminated</option></select></div>
                </div>
                <div class="form-group full-width"><label>Notes</label><textarea name="notes" id="edit_notes" rows="2"></textarea></div>
                <div class="modal-actions"><button type="button" onclick="closeModal('editModal')" class="btn btn-outline">Cancel</button><button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> Update</button></div>
            </form>
        </div>
    </div>

    <script>
    function toggleSidebar(){document.getElementById('sidebar').classList.toggle('sidebar-open');document.querySelector('.main-content').classList.toggle('main-shifted');}
    function openModal(id){document.getElementById(id).classList.add('active');}
    function closeModal(id){document.getElementById(id).classList.remove('active');}
    function openEditModal(t){
        document.getElementById('editForm').action='/teachers/'+t.id+'/update';
        document.getElementById('edit_full_name').value=t.full_name;
        document.getElementById('edit_gender').value=t.gender;
        document.getElementById('edit_qualification').value=t.qualification;
        document.getElementById('edit_subject').value=t.subject_specialization;
        document.getElementById('edit_school').value=t.school_id || '';
        document.getElementById('edit_phone').value=t.phone||'';
        document.getElementById('edit_email').value=t.email||'';
        document.getElementById('edit_hire_date').value=t.hire_date?new Date(t.hire_date).toISOString().split('T')[0]:'';
        document.getElementById('edit_salary').value=t.salary||'';
        document.getElementById('edit_experience').value=t.experience_years||'';
        document.getElementById('edit_status').value=t.status;
        document.getElementById('edit_notes').value=t.notes||'';
        openModal('editModal');
    }
    document.querySelectorAll('.modal-overlay').forEach(m=>{m.addEventListener('click',e=>{if(e.target===m)closeModal(m.id)})});
    function toggleSchoolGroup(groupIndex) {
        const rows = document.querySelectorAll('.group-' + groupIndex);
        const indicator = document.getElementById('group-indicator-' + groupIndex);
        if (!rows.length || !indicator) return;
        const isHidden = rows[0].style.display === 'none';
        rows.forEach(row => { row.style.display = isHidden ? '' : 'none'; });
        indicator.textContent = isHidden ? '▾' : '▸';
    }
    setTimeout(()=>{document.querySelectorAll('.page-alert').forEach(el=>{el.style.animation='slideUp 0.3s ease forwards';setTimeout(()=>el.remove(),300)})},5000);
    </script>
</body>
</html>
