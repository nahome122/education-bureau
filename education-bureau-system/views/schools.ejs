<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> | TSMS</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="/style.css">
</head>
<body class="app-body">
    <aside class="sidebar" id="sidebar">
        <div class="sidebar-header">
            <div class="sidebar-logo"><i class="fas fa-graduation-cap"></i><div><h2>TSMS</h2><span>Education Bureau</span></div></div>
            <button class="sidebar-close" onclick="toggleSidebar()"><i class="fas fa-times"></i></button>
        </div>
        <nav class="sidebar-nav">
            <a href="/dashboard" class="nav-link"><i class="fas fa-chart-pie"></i><span>Dashboard</span></a>
            <a href="/teachers" class="nav-link"><i class="fas fa-chalkboard-teacher"></i><span>Teachers</span></a>
            <a href="/schools" class="nav-link active"><i class="fas fa-school"></i><span>Schools</span></a>
            <a href="/staff" class="nav-link"><i class="fas fa-users-cog"></i><span>Staff</span></a>
            <a href="/attendance" class="nav-link"><i class="fas fa-calendar-check"></i><span>Attendance</span></a>
            <a href="/leaves" class="nav-link"><i class="fas fa-calendar-times"></i><span>Leaves</span></a>
            <% if (user && user.role === 'admin') { %><a href="/users" class="nav-link"><i class="fas fa-user-shield"></i><span>Users</span></a><% } %>
        </nav>
        <div class="sidebar-footer">
            <div class="user-info"><div class="user-avatar" style="background:<%= user ? user.avatar_color : '#10b981' %>"><%= user ? user.full_name.charAt(0).toUpperCase() : 'A' %></div><div class="user-details"><span class="user-name"><%= user ? user.full_name : 'Admin' %></span><span class="user-role"><%= user ? user.role : 'admin' %></span></div></div>
            <a href="/logout" class="btn-logout"><i class="fas fa-sign-out-alt"></i></a>
        </div>
    </aside>

    <main class="main-content">
        <header class="top-bar">
            <div class="top-bar-left"><button class="menu-toggle" onclick="toggleSidebar()"><i class="fas fa-bars"></i></button><div><h1>School Management</h1><p class="breadcrumb"><a href="/dashboard">Dashboard</a> / Schools</p></div></div>
            <div class="top-bar-right" style="display:flex;gap:8px">
                <% if (user && canCreate('schools')) { %><button class="btn btn-primary" onclick="openModal('addSchoolModal')"><i class="fas fa-plus"></i> Add School</button><% } %>
            </div>
        </header>

        <% if (success_msg && success_msg.length > 0) { %><div class="alert alert-success page-alert"><i class="fas fa-check-circle"></i><span><%= success_msg[0] %></span><button onclick="this.parentElement.remove()" class="alert-close">&times;</button></div><% } %>
        <% if (error_msg && error_msg.length > 0) { %><div class="alert alert-error page-alert"><i class="fas fa-exclamation-circle"></i><span><%= error_msg[0] %></span><button onclick="this.parentElement.remove()" class="alert-close">&times;</button></div><% } %>

        <div class="table-card">
            <div class="table-responsive">
                <table>
                    <thead><tr><th>#</th><th>School Name</th><th>Address</th><th>Description</th><th>Actions</th></tr></thead>
                    <tbody>
                    <% if (schools.length > 0) { schools.forEach((school, index) => { %>
                    <tr>
                        <td><%= index + 1 %></td>
                        <td><%= school.name %></td>
                        <td><%= school.address || '-' %></td>
                        <td><%= school.description || '-' %></td>
                        <td class="actions-cell">
                            <% if (user && canUpdate('schools')) { %><button class="btn-icon btn-edit" onclick='openEditSchoolModal(<%- JSON.stringify(school) %>)' title="Edit"><i class="fas fa-edit"></i></button><% } %>
                            <% if (user && canDelete('schools')) { %><form action="/schools/<%= school.id %>/delete" method="POST" style="display:inline" onsubmit="return confirm('Delete this school?')"><button type="submit" class="btn-icon btn-delete" title="Delete"><i class="fas fa-trash"></i></button></form><% } %>
                        </td>
                    </tr>
                    <% }) } else { %>
                    <tr><td colspan="5" class="empty-state"><i class="fas fa-inbox"></i><br>No schools found</td></tr>
                    <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </main>

    <div class="modal-overlay" id="addSchoolModal">
        <div class="modal">
            <div class="modal-header"><h2><i class="fas fa-school"></i> Add School</h2><button onclick="closeModal('addSchoolModal')" class="modal-close">&times;</button></div>
            <form action="/schools" method="POST" class="modal-form">
                <div class="form-grid">
                    <div class="form-group"><label>School Name *</label><input type="text" name="name" required></div>
                    <div class="form-group"><label>Address</label><input type="text" name="address"></div>
                    <div class="form-group full-width"><label>Description</label><textarea name="description" rows="3"></textarea></div>
                </div>
                <div class="modal-actions"><button type="button" onclick="closeModal('addSchoolModal')" class="btn btn-outline">Cancel</button><button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> Save School</button></div>
            </form>
        </div>
    </div>

    <div class="modal-overlay" id="editSchoolModal">
        <div class="modal">
            <div class="modal-header"><h2><i class="fas fa-edit"></i> Edit School</h2><button onclick="closeModal('editSchoolModal')" class="modal-close">&times;</button></div>
            <form id="editSchoolForm" method="POST" class="modal-form">
                <div class="form-grid">
                    <div class="form-group"><label>School Name *</label><input type="text" name="name" id="edit_school_name" required></div>
                    <div class="form-group"><label>Address</label><input type="text" name="address" id="edit_school_address"></div>
                    <div class="form-group full-width"><label>Description</label><textarea name="description" id="edit_school_description" rows="3"></textarea></div>
                </div>
                <div class="modal-actions"><button type="button" onclick="closeModal('editSchoolModal')" class="btn btn-outline">Cancel</button><button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> Update School</button></div>
            </form>
        </div>
    </div>

    <script>
    function toggleSidebar(){document.getElementById('sidebar').classList.toggle('sidebar-open');document.querySelector('.main-content').classList.toggle('main-shifted');}
    function openModal(id){document.getElementById(id).classList.add('active');}
    function closeModal(id){document.getElementById(id).classList.remove('active');}
    function openEditSchoolModal(school) {
        const form = document.getElementById('editSchoolForm');
        form.action = '/schools/' + school.id + '/update';
        document.getElementById('edit_school_name').value = school.name;
        document.getElementById('edit_school_address').value = school.address || '';
        document.getElementById('edit_school_description').value = school.description || '';
        openModal('editSchoolModal');
    }
    document.querySelectorAll('.modal-overlay').forEach(m=>{m.addEventListener('click',e=>{if(e.target===m)closeModal(m.id)})});
    </script>
</body>
</html>
